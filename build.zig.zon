.{
    .name = .spider,
    .version = "0.10.1",
    .fingerprint = 0x6ad76a84ae06b73f,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .pacman = .{
            .path = "modules/pacman",
        },
        // Lazy: only fetched when an app (or this repo) builds with
        // -Dio_backend=zio. The build script asks for it with
        // lazyDependency(); on a cold cache the first configure pass comes
        // back without it, Zig fetches it and configures again, all within
        // one `zig build`.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio#3bbd74d68a889e5d4da7274afdc7c7617ec614d6",
            .hash = "zio-0.19.0-xHbVVMFBLACx1T0028HttNTseV6bDeL0AI4id51AHx57",
            .lazy = true,
        },
        .pg = .{
            .path = "modules/pg/pg_driver_impl",
        },
        .spider_pg = .{
            .path = "modules/pg",
            .lazy = true,
        },
        .spider_r2 = .{
            .path = "modules/r2",
            .lazy = true,
        },
        .spider_sqlite = .{
            .path = "modules/sqlite",
            .lazy = true,
        },
        .spider_qrcode = .{
            .path = "modules/qrcode",
            .lazy = true,
        },
        .spider_xlsx = .{
            .path = "modules/xlsx",
            .lazy = true,
        },
        .zqlite = .{
            .path = "modules/sqlite/sqlite_driver_impl",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "lib.zig",
        "includes",
        "README.md",
        "AGENTS.md",
        "llms.txt",
        "modules",
    },
}
