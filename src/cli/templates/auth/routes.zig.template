const spider = @import("spider");
const auth = @import("mod.zig");
const controller = @import("controller.zig");

/// Mounted by `server.mountFeatures(features)` in src/main.zig. Login,
/// callback and logout are `.public`: the auth middleware lets them through
/// without a session. /auth/session needs the session the callback created.
pub fn build() spider.Group {
    const p = auth.provider orelse @panic("set features.auth.provider before mountFeatures (src/main.zig)");
    var g = spider.Group.init("/auth");
    _ = g
        .get("/login", p.loginHandler(), .{ .public = true })
        .get("/callback", p.callbackHandler(), .{ .public = true })
        .get("/logout", controller.logout, .{ .public = true })
        .get("/session", controller.session, .{});
    return g;
}
