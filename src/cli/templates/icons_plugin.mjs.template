//
// Icon set "{{set}}" as Tailwind classes: <span class="{{prefix}}-NAME"></span>,
// one per SVG in ./{{set}}/ (downloaded by `spider install`). Tailwind only
// emits the classes your templates use. The icon takes the text color
// (currentColor); size with size-4, size-5, ...
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const prefix = "{{prefix}}";
const dir = path.join(path.dirname(fileURLToPath(import.meta.url)), "{{set}}");

export default {
  handler({ matchComponents }) {
    const values = {};
    for (const file of fs.readdirSync(dir)) {
      if (file.endsWith(".svg")) values[file.slice(0, -4)] = file;
    }
    matchComponents(
      {
        [prefix]: (file) => {
          const svg = fs.readFileSync(path.join(dir, file), "utf8").replace(/\r?\n|\r/g, "");
          const name = file.slice(0, -4);
          const size = name.endsWith("-micro") ? "1rem" : name.endsWith("-mini") ? "1.25rem" : "1.5rem";
          const url = `url("data:image/svg+xml;utf8,${encodeURIComponent(svg)}")`;
          return {
            "--icon": url,
            "-webkit-mask": "var(--icon) no-repeat center / contain",
            mask: "var(--icon) no-repeat center / contain",
            "background-color": "currentColor",
            display: "inline-block",
            "vertical-align": "middle",
            "flex-shrink": "0",
            width: size,
            height: size,
          };
        },
      },
      { values },
    );
  },
};
