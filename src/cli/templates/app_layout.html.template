<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{ title ?? "{{app_name}}" }</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="stylesheet" href="/css/app.css">
    <script src="/js/htmx.min.js"></script>
    <script defer src="/js/stores.js"></script>
    <script defer src="/js/alpine.min.js"></script>
    <style>[x-cloak] { display: none !important; }</style>
</head>
<!-- App shell: navbar, sidebar (a drawer on small screens) and a bottom nav
     on mobile. Use it from a page with `extends "app"`; the minimal layout is
     `extends "layout"`. -->
<body class="bg-base-100 text-base-content min-h-screen">
    <NavBar />
    <SideBar />
    <main class="pt-14 pb-16 lg:pb-0 lg:pl-64">
        <div class="p-4 lg:p-6">
            { slot }
        </div>
    </main>
    <MobileNav />
    <Toast />
</body>
</html>
