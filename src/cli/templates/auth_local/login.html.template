extends "layout"

<main class="min-h-screen flex items-center justify-center p-6">
    <div class="ui-card w-full max-w-sm p-8 gap-6">
        <h1 class="text-2xl font-semibold">Sign in</h1>

        if (problem != "") {
        <p class="ui-alert ui-alert-error" role="alert">{ problem }</p>
        }

        <form class="flex flex-col gap-4" action="/auth/login" method="post">
            <label class="ui-field">
                <span class="ui-label">Email</span>
                <input class="ui-input" name="email" type="email" value="{ email }" autocomplete="email" required autofocus>
            </label>
            <label class="ui-field">
                <span class="ui-label">Password</span>
                <input class="ui-input" name="password" type="password" autocomplete="current-password" required>
            </label>
            <button class="ui-btn ui-btn-primary" type="submit">Sign in</button>
        </form>

        <p class="text-sm">No account yet? <a class="underline" href="/auth/register">Create one</a></p>
    </div>
</main>
