<div class="ui-card p-4 mt-4">
    <form hx-post="/{{plural}}/create"
          hx-target="#{{feature}}-list"
          hx-swap="afterbegin"
          hx-on::after-request="if(event.detail.successful) this.closest('.ui-card').remove()">

        <label class="ui-field mb-3">
            <span class="ui-label">Name</span>
            <input class="ui-input" name="name" placeholder="{{Feature}} name..." />
        </label>
        <div class="flex gap-2 justify-end">
            <button type="button" class="ui-btn ui-btn-ghost ui-btn-sm"
                    @click="$el.closest('.ui-card').remove()">Cancel</button>
            <button class="ui-btn ui-btn-primary ui-btn-sm" type="submit">Save</button>
        </div>
    </form>
</div>
