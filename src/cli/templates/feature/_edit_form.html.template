<h3 class="font-bold text-lg mb-4">Edit {{Feature}}</h3>
<form hx-post="/{{plural}}/{ id }/update"
      hx-target="#{{feature}}-{ id }"
      hx-swap="outerHTML">
    <label class="ui-field mb-4">
        <span class="ui-label">Name</span>
        <input class="ui-input" name="name" value="{ name }" />
    </label>
    <div class="flex gap-2 justify-end">
        <button type="button" class="ui-btn ui-btn-ghost"
                @click="editModal = false">Cancel</button>
        <button class="ui-btn ui-btn-primary" type="submit">Save</button>
    </div>
</form>
